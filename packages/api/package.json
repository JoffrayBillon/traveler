{
  "name": "@traveler/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/dev.ts",
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/app.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run src && node --test test/distribution.test.mjs",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts && biome check --write drizzle/meta",
    "db:migrate": "node --env-file-if-exists=../../.env.local --import tsx src/migrate.ts",
    "trips:create": "node --env-file-if-exists=../../.env.local --import tsx src/create-trip.ts",
    "trips:list": "node --env-file-if-exists=../../.env.local --import tsx src/list-trips.ts",
    "managers:create": "node --env-file-if-exists=../../.env.local --import tsx src/create-manager.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.2.0",
    "@hono/node-server": "2.1.5",
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.5",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
